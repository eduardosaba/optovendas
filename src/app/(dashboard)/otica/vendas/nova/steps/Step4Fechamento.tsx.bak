"use client";

import { useMemo, useState, useEffect, useRef } from "react";
import { CreditCard, BadgePercent, Signature, Paperclip, X, Calculator, Calendar, MapPin, Loader2, FileText } from "lucide-react";
import { useRouter } from 'next/navigation';
import { supabase } from "@/lib/supabase";
import { postJson } from "@/lib/api-client";
import { resolveClinicaContext } from "@/lib/clinica";
import SignatureTermPad from "@/components/shared/SignatureTermPad";
import { pdf, Document, Page, Text, View, StyleSheet, Image as PDFImage, PDFDownloadLink } from '@react-pdf/renderer';
import PDFCarne from '@/components/otica/DocumentoCarne';
import gerarCronogramaCobranca from '@/lib/financeiro/gerador-parcelas';
import { NumericFormat } from 'react-number-format';
import { useToast } from '@/components/ui/ToastProvider';
import { useConfig } from '@/context/ConfigContext';
import type { VendaData } from "./types";

const TERMO_COMPRA = `Declaro que recebi os produtos descritos neste comprovante e concordo com as condições de venda, pagamentos e prazos estabelecidos. Estou ciente de que a entrega e ajuste do(s) produto(s) seguem o processo de fabricação e podem sofrer prazos informados pela ótica. Qualquer alteração será comunicada ao cliente.`;

type Props = {
  data: VendaData;
  onChange: (next: VendaData) => void;
  termoTexto: string;
};

export default function Step4Fechamento({ data, onChange, termoTexto }: Props) {
  const toast = useToast();
  const config = useConfig();
  const router = useRouter();
  const fileInputRef = useRef<HTMLInputElement | null>(null);

  // Estados locais
  const [qtdParcelas, setQtdParcelas] = useState(1);
  const [primeiroVencimento, setPrimeiroVencimento] = useState(new Date().toISOString().slice(0, 10));
  const [loading, setLoading] = useState(false);

  // Modais de Assinatura
  const [termoOpen, setTermoOpen] = useState(false);
  const [purchaseOpen, setPurchaseOpen] = useState(false);
  const [confirmNoPaymentOpen, setConfirmNoPaymentOpen] = useState(false);

  const totalGeral = Number(data.financeiro?.total || 0);
  const valorEntrada = Number(data.financeiro?.valorEntrada || 0);
  const saldoRestante = Math.max(0, totalGeral - valorEntrada);
  const valorPorParcela = saldoRestante / (qtdParcelas || 1);

  const { parcelas } = useMemo(() => {
    if (data.financeiro?.formaSaldo === 'crediario') {
      return gerarCronogramaCobranca(
        totalGeral,
        valorEntrada,
        qtdParcelas,
        primeiroVencimento
      );
    }
    return { parcelas: [] } as any;
  }, [totalGeral, valorEntrada, qtdParcelas, primeiroVencimento, data.financeiro?.formaSaldo]);

  // Sincroniza dados de crediário
  useEffect(() => {
    if (data.financeiro?.formaSaldo === 'crediario') {
      onChange({
        ...data,
        financeiro: {
          ...data.financeiro,
          qtdParcelas,
          primeiroVencimento,
          valorParcela: valorPorParcela,
        },
      } as any);
    }
  }, [qtdParcelas, primeiroVencimento, saldoRestante, data.financeiro?.formaSaldo]);

  // --- GERADOR DE PDF DE ASSINATURA ---
  async function generateSignaturePDF(base64: string, title: string, content: string) {
    const styles = StyleSheet.create({
      page: { padding: 40, fontSize: 11, fontFamily: 'Helvetica' },
      title: { fontSize: 16, fontWeight: 'bold', textAlign: 'center', marginBottom: 20 },
      box: { padding: 15, border: 1, borderColor: '#eee', borderRadius: 8, backgroundColor: '#fafafa', marginBottom: 20 },
      label: { fontWeight: 'bold' },
      signature: { width: 280, height: 80, alignSelf: 'center', marginTop: 20 },
      footer: { marginTop: 40, textAlign: 'center', color: '#888', fontSize: 9, borderTop: 1, paddingTop: 10 }
    });

    const MyDoc = (
      <Document>
        <Page style={styles.page}>
          <Text style={styles.title}>{title}</Text>
          <Text style={{ textAlign: 'justify', marginBottom: 20, lineHeight: 1.4 }}>{content}</Text>

          <View style={styles.box}>
            <Text style={{ fontSize: 12, fontWeight: 'bold', marginBottom: 8 }}>DADOS DO CLIENTE:</Text>
            <Text><Text style={styles.label}>NOME COMPLETO: </Text>{data.cliente?.nome_completo || '---'}</Text>
            <Text><Text style={styles.label}>CPF: </Text>{data.cliente?.cpf || '---'}</Text>
            <Text><Text style={styles.label}>DATA: </Text>{new Date().toLocaleDateString('pt-BR')}</Text>
            <Text><Text style={styles.label}>CIDADE: </Text>{data.cliente?.cidade_atendimento || 'Feira de Santana'}</Text>
          </View>

          <PDFImage src={base64} style={styles.signature} />
          <Text style={{ textAlign: 'center', fontSize: 10, marginTop: 5 }}>Assinatura Digital do Cliente</Text>

          <View style={styles.footer}>
             <Text>Documento gerado e autenticado pela plataforma OptoVendas em {new Date().toLocaleString('pt-BR')}</Text>
          </View>
        </Page>
      </Document>
    );
    return await pdf(MyDoc).toBlob();
  }

  // --- UPLOAD PARA O STORAGE ---
  async function handleSignatureSave(base64: string, type: 'compra' | 'termo') {
    try {
      const ctx = await resolveClinicaContext();
      const title = type === 'compra' ? 'RECONHECIMENTO DE COMPRA' : 'TERMO DE RESPONSABILIDADE';
      const content = type === 'compra' ? TERMO_COMPRA : termoTexto;

      const blob = await generateSignaturePDF(base64, title, content);
      const fileName = `${type}-${Date.now()}.pdf`;
      const path = `clinicas/${ctx.clinicaId}/vendas/assinaturas/${fileName}`;

      const { error } = await supabase.storage.from('branding-assets').upload(path, blob);
      if (error) throw error;

      const url = supabase.storage.from('branding-assets').getPublicUrl(path).data.publicUrl;
      
      const currentAnexos = Array.isArray(data.anexos_urls) ? [...data.anexos_urls] : [];
      
      onChange({
        ...data,
        [type === 'compra' ? 'assinatura' : 'termoQuebraAceito']: base64,
        anexos_urls: [...currentAnexos, url]
      });

      toast.success("Documento assinado e salvo nos anexos!");
    } catch (e) {
      console.error(e);
      toast.error("Erro ao salvar assinatura no servidor.");
    }
  }

  // Upload helper que retorna a URL pública do PDF gerado
  async function uploadSignature(base64: string, type: 'compra' | 'termo-armacao') {
    const ctx = await resolveClinicaContext();
    const title = type === 'compra' ? 'RECONHECIMENTO DE COMPRA' : 'TERMO DE RESPONSABILIDADE';
    const content = type === 'compra' ? TERMO_COMPRA : termoTexto;

    const blob = await generateSignaturePDF(base64, title, content);
    const fileName = `${type.replace(/[^a-z0-9]/gi, '-')}-${Date.now()}.pdf`;
    const path = `clinicas/${ctx.clinicaId}/vendas/assinaturas/${fileName}`;

    const { error } = await supabase.storage.from('branding-assets').upload(path, blob);
    if (error) throw error;

    const url = supabase.storage.from('branding-assets').getPublicUrl(path).data.publicUrl;
    return url;
  }

  // --- FINALIZAÇÃO MESTRE ---
  async function handleFinalizar(tipo: 'normal' | 'sem_pagamento') {
    if (tipo === 'normal' && !data.assinatura) {
      toast.error("Colha a assinatura de reconhecimento de compra antes de finalizar.");
      return;
    }

    setLoading(true);
    try {
      const ctx = await resolveClinicaContext();
      
      const payload = {
        ...data,
        clinica_id: ctx.clinicaId,
        paciente_id: data.cliente?.id,
        status_os: tipo === 'sem_pagamento' || data.financeiro?.formaSaldo === 'saldo_entrega' 
                   ? 'Aguardando Liberação' 
                   : 'Aguardando',
        finalizado_em: new Date().toISOString(),
        status_financeiro: tipo === 'sem_pagamento' ? 'pendente' : 'confirmado'
      };

      // O endpoint /api/otica/vendas/finalize deve estar preparado para receber o payload completo
      const response = await postJson('/api/otica/vendas/finalize', payload);

      if (response.error) throw new Error(response.error);

      toast.success("Venda finalizada e salva no histórico!");
      router.push('/otica/os');
    } catch (err: any) {
      console.error(err);
      toast.error("Erro 403: Verifique se você está logado ou se tem permissão.");
    } finally {
      setLoading(false);
    }
  }

  return (
    <div className="grid grid-cols-1 xl:grid-cols-2 gap-8 animate-in fade-in slide-in-from-bottom-4">
      
      {/* FINANCEIRO */}
      <div className="space-y-6">
        <section className="bg-white p-8 rounded-[40px] shadow-sm border border-slate-50 space-y-6">
          <div className="flex items-center gap-3">
            <div className="p-2 bg-emerald-50 text-emerald-600 rounded-lg"><Calculator size={20} /></div>
            <h2 className="text-xl font-black text-slate-800">Fechamento Financeiro</h2>
          </div>

          <div className="grid grid-cols-2 gap-4">
            <div className="p-4 bg-slate-50 rounded-2xl border border-slate-100">
              <span className="text-[10px] font-black uppercase text-slate-400">Total</span>
              <p className="text-xl font-black text-slate-700">R$ {totalGeral.toFixed(2)}</p>
            </div>
            <div className="p-4 bg-emerald-50 rounded-2xl border border-emerald-100">
              <span className="text-[10px] font-black uppercase text-emerald-600">Saldo</span>
              <p className="text-xl font-black text-emerald-700">R$ {saldoRestante.toFixed(2)}</p>
            </div>
          </div>

          <div className="space-y-4">
            <label className="text-[10px] font-black uppercase text-slate-400 ml-2 block">Entrada</label>
            <NumericFormat
              value={valorEntrada}
              thousandSeparator="."
              decimalSeparator=","
              prefix="R$ "
              className="w-full p-4 bg-slate-50 rounded-2xl font-black text-xl text-slate-700"
              onValueChange={(vals) => onChange({ ...data, financeiro: { ...data.financeiro, valorEntrada: vals.floatValue || 0 } } as any)}
            />

            {saldoRestante > 0 && (
              <select
                value={data.financeiro?.formaSaldo || ''}
                onChange={(e) => onChange({ ...data, financeiro: { ...data.financeiro, formaSaldo: e.target.value } } as any)}
                className="w-full p-4 bg-white rounded-2xl border border-slate-100 font-bold"
              >
                <option value="">Forma do Saldo...</option>
                <option value="pix">PIX</option>
                <option value="cartao">Cartão de Crédito</option>
                <option value="crediario">Crediário Próprio</option>
                <option value="saldo_entrega">Saldo na Entrega</option>
              </select>
            )}

            {data.financeiro?.formaSaldo === 'crediario' && (
              <div className="p-6 bg-blue-50 rounded-[32px] border border-blue-100 grid grid-cols-2 gap-4">
                <div>
                  <label className="text-[9px] font-black text-blue-400 uppercase">Parcelas</label>
                  <select value={qtdParcelas} onChange={(e) => setQtdParcelas(Number(e.target.value))} className="w-full p-2 rounded-lg">
                    {[1,2,3,4,5,6,10,12].map(n => <option key={n} value={n}>{n}x</option>)}
                  </select>
                </div>
                <div>
                  <label className="text-[9px] font-black text-blue-400 uppercase">1º Vencimento</label>
                  <input type="date" value={primeiroVencimento} onChange={(e) => setPrimeiroVencimento(e.target.value)} className="w-full p-2 rounded-lg" />
                </div>
              </div>
            )}
          </div>
        </section>

        <div className="flex flex-col gap-3">
          <button 
            onClick={() => setConfirmNoPaymentOpen(true)}
            className="w-full py-4 bg-rose-50 text-rose-600 rounded-2xl font-black text-[11px] uppercase tracking-widest"
          >
            Finalizar sem Pagamento
          </button>
          <button 
            disabled={loading}
            onClick={() => handleFinalizar('normal')}
            className="w-full py-6 bg-cyan-500 text-white rounded-[28px] font-black text-xl shadow-xl hover:bg-slate-900 transition-all flex items-center justify-center gap-3"
          >
            {loading ? <Loader2 className="animate-spin" /> : 'Finalizar e Gerar O.S.'}
          </button>
        </div>
      </div>

      {/* FORMALIZAÇÃO */}
      <div className="space-y-6">
        <section className="bg-white p-8 rounded-[40px] shadow-sm border border-slate-50 space-y-6">
          <div className="flex items-center gap-3">
            <div className="p-2 bg-blue-50 text-blue-600 rounded-lg"><Signature size={20} /></div>
            <h2 className="text-xl font-black text-slate-800">Assinaturas Digitais</h2>
          </div>

          <div className="space-y-4">
            {/* COMPRA */}
            <div className={`p-5 rounded-3xl border ${data.assinatura ? 'bg-emerald-50 border-emerald-100' : 'bg-slate-50 border-slate-100'}`}>
              <div className="flex justify-between items-center">
                <div>
                  <p className="font-black text-slate-700 text-sm">Reconhecimento de Compra</p>
                  <p className="text-[10px] text-slate-400 uppercase">{data.assinatura ? '✓ PDF Gerado e Anexado' : 'Pendente'}</p>
                </div>
                <button onClick={() => setPurchaseOpen(true)} className="bg-white border p-3 rounded-2xl shadow-sm"><Signature size={18}/></button>
              </div>
            </div>

            {/* ARMAÇÃO PRÓPRIA */}
            <div className={`p-5 rounded-3xl border ${data.termoQuebraAceito ? 'bg-emerald-50 border-emerald-100' : 'bg-slate-50 border-slate-100'}`}>
              <div className="flex justify-between items-center">
                <div>
                  <p className="font-black text-slate-700 text-sm">Risco de Quebra (Armação Própria)</p>
                  <p className="text-[10px] text-slate-400 uppercase">{data.termoQuebraAceito ? '✓ PDF Gerado e Anexado' : 'Pendente'}</p>
                </div>
                <button onClick={() => setTermoOpen(true)} className="bg-white border p-3 rounded-2xl shadow-sm"><FileText size={18}/></button>
              </div>
            </div>
          </div>
        </section>

        {/* CARNÊ (DOWNLOAD) */}
        {data.financeiro?.formaSaldo === 'crediario' && (
          <div className="mt-4 p-4 bg-indigo-50 rounded-[32px] border border-indigo-100 flex items-center justify-between">
            <div>
              <p className="text-[10px] font-black text-indigo-600 uppercase">Carnê Pronto</p>
              <p className="text-xs text-indigo-400">Clique para baixar o arquivo de cobrança</p>
            </div>

            <PDFDownloadLink
              document={<PDFCarne paciente={data.cliente} venda={data} parcelas={parcelas} config={config} />}
              fileName={`Carne_${(data.cliente?.nome_completo || 'cliente').replace(/\s/g, '_')}.pdf`}
              className="bg-indigo-600 text-white px-6 py-3 rounded-2xl font-black text-[10px] uppercase shadow-lg shadow-indigo-100"
            >
              {({ loading }: any) => loading ? 'GERANDO...' : 'BAIXAR CARNÊ'}
            </PDFDownloadLink>
          </div>
        )}

        {/* ANEXOS */}
        <section className="bg-white p-6 rounded-[40px] shadow-sm border border-slate-50">
           <h3 className="font-black text-sm mb-4 flex items-center gap-2"><Paperclip size={16}/> Documentos e Fotos</h3>
           <div className="grid grid-cols-4 gap-2">
              {data.anexos_urls?.map((url, i) => (
                <div key={i} className="aspect-square rounded-xl overflow-hidden border bg-slate-50 flex items-center justify-center">
                   {url.endsWith('.pdf') ? <FileText className="text-slate-300" /> : <img src={url} className="w-full h-full object-cover" />}
                </div>
              ))}
              <button onClick={() => fileInputRef.current?.click()} className="aspect-square border-2 border-dashed border-slate-200 rounded-xl flex items-center justify-center text-slate-300">+</button>
           </div>
           <input type="file" ref={fileInputRef} className="hidden" multiple />
        </section>
      </div>

      {/* MODAL SEM PAGAMENTO */}
      {confirmNoPaymentOpen && (
        <div className="fixed inset-0 z-[300] flex items-center justify-center bg-slate-900/60 backdrop-blur-md p-4">
          <div className="bg-white p-8 rounded-[40px] max-w-md w-full">
            <h2 className="text-2xl font-black text-slate-900 mb-2">Finalizar sem Valor?</h2>
            <p className="text-slate-500 text-sm mb-8">A OS ficará como <strong>Aguardando Liberação</strong> e não irá para a produção.</p>
            <div className="flex gap-4">
              <button onClick={() => setConfirmNoPaymentOpen(false)} className="flex-1 font-black text-slate-400">CANCELAR</button>
              <button onClick={() => handleFinalizar('sem_pagamento')} className="flex-1 py-4 bg-rose-500 text-white rounded-2xl font-black">CONFIRMAR</button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL ASSINATURA COMPRA */}
      {purchaseOpen && (
        <div className="fixed inset-0 z-[300] flex items-center justify-center bg-slate-900/60 backdrop-blur-md p-4">
           <div className="bg-white p-8 rounded-[40px] max-w-2xl w-full">
              <SignatureTermPad 
                titulo="Assinatura do Cliente"
                descricao={TERMO_COMPRA}
                onConfirm={async (base64) => {
                   const url = await uploadSignature(base64, 'compra');
                   const urls = [...(data.anexos_urls || [])];
                   if (url) urls.push(url);
                   onChange({...data, assinatura: base64, anexos_urls: urls} as any);
                   setPurchaseOpen(false);
                   toast.success("Assinatura de compra registrada!");
                }}
              />
              <button onClick={() => setPurchaseOpen(false)} className="mt-4 w-full text-slate-400 font-bold">CANCELAR</button>
           </div>
        </div>
      )}

      {/* MODAL ASSINATURA TERMO ARMAÇÃO */}
      {termoOpen && (
        <div className="fixed inset-0 z-[300] flex items-center justify-center bg-slate-900/60 backdrop-blur-md p-4">
           <div className="bg-white p-8 rounded-[40px] max-w-2xl w-full">
              <SignatureTermPad 
                titulo="Termo de Responsabilidade"
                descricao={termoTexto}
                onConfirm={async (base64) => {
                   const url = await uploadSignature(base64, 'termo-armacao');
                   const urls = [...(data.anexos_urls || [])];
                   if (url) urls.push(url);
                   onChange({...data, termoQuebraAceito: true, anexos_urls: urls} as any);
                   setTermoOpen(false);
                   toast.success("Termo de armação registrado!");
                }}
              />
              <button onClick={() => setTermoOpen(false)} className="mt-4 w-full text-slate-400 font-bold">CANCELAR</button>
           </div>
        </div>
      )}

    </div>
  );
}
