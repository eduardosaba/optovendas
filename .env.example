# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chave interna usada pelos endpoints protegidos (server-side)
INTERNAL_API_KEY=

# Necessário para chamadas feitas em Client Components que enviam x-internal-key
# ATENCAO: qualquer variavel NEXT_PUBLIC_ fica visivel no bundle do navegador.
# Em producao, prefira mover essas chamadas para Server Actions/Route Handlers sem expor chave publica.
NEXT_PUBLIC_INTERNAL_API_KEY=
